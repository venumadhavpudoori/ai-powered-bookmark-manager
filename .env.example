# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/recallai
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@db:5432/recallai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=recallai

# ── Auth ──────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ── AI Provider ───────────────────────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ── Rate Limits ───────────────────────────────────────────
RATE_LIMIT_BOOKMARKS=30/minute
RATE_LIMIT_SEARCH=60/minute

# ── Worker ────────────────────────────────────────────────
WORKER_POLL_INTERVAL=2
WORKER_BATCH_SIZE=5

# ── Next.js ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
